      "post": {
        "tags": [
          "Buildings"
        ],
        "summary": "Create building (ADMIN)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBuildingBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created building",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Building"
